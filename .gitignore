# Laravel standard ignores
/vendor
/node_modules
/public/build
/public/hot
/public/storage
/public/fonts-manifest.dev.json

# Environment files
.env
.env.backup
.env.production
.env.*.local

# Logs and runtime caches
*.log
/storage/logs/*.log
/storage/*.key
/storage/pail
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore

# SQLite files (migrated to Supabase PostgreSQL)
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite3-journal
/database/*.sqlite

# IDE and Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.phpunit.result.cache
/.phpunit.cache
/.cursor/
/.codex
/.nova
/.zed
/auth.json
_ide_helper.php
Homestead.json
Homestead.yaml

# Private payroll documents
/storage/app/private/payroll/
