{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/build/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_NAME": "HRM Backend",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_KEY": "base64:kjE7C26JgU10yMsO9EH0s5CqxQ/4/FTNaZyGN3fshgw=",
    "APP_URL": "https://hrm-php-backend-indol.vercel.app",
    "APP_TIMEZONE": "Asia/Dhaka",
    "VERCEL": "1",
    "APP_CONFIG_CACHE": "/tmp/bootstrap/cache/config.php",
    "APP_EVENTS_CACHE": "/tmp/bootstrap/cache/events.php",
    "APP_PACKAGES_CACHE": "/tmp/bootstrap/cache/packages.php",
    "APP_ROUTES_CACHE": "/tmp/bootstrap/cache/routes.php",
    "APP_SERVICES_CACHE": "/tmp/bootstrap/cache/services.php",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "CACHE_STORE": "database",
    "SESSION_DRIVER": "cookie",
    "QUEUE_CONNECTION": "sync",
    "LOG_CHANNEL": "stderr",
    "DB_CONNECTION": "pgsql",
    "DB_HOST": "ep-small-darkness-b36178y3-pooler.c-4.ap-southeast-1.aws.neon.tech",
    "DB_PORT": "5432",
    "DB_DATABASE": "neondb",
    "DB_USERNAME": "neondb_owner",
    "DB_PASSWORD": "npg_8SWc7GDoehsA",
    "DB_SSLMODE": "require",
    "DB_EMULATE_PREPARES": "true",
    "DB_PERSISTENT": "false",
    "FORCE_HTTPS": "true"
  }
}
